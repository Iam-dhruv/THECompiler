.data

.text
func_begin add@ii
  params: a:int, b:int
  0: t1 = a + b
  1: return t1
func_end add@ii

func_begin add@ff
  params: a:float, b:float
  2: t1 = a + b
  3: return t1
func_end add@ff

func_begin add@iii
  params: a:int, b:int, c:int
  4: t1 = a + b
  5: t2 = t1 + c
  6: return t2
func_end add@iii

func_begin main
  locals: i:int, f:float, t:int, g:float
  7: param 1
  8: param 2
  9: t1 = call add@ii, 2
  10: i = t1
  11: param 1.5
  12: param 2.5
  13: t2 = call add@ff, 2
  14: f = t2
  15: param 1
  16: param 2
  17: param 3
  18: t3 = call add@iii, 3
  19: t = t3
  20: param f
  21: param 1.0
  22: t4 = call add@ff, 2
  23: g = t4
  24: t5 = i + t
  25: return t5
func_end main
