.data

.text
func_begin add@ff
  params: a:float, b:float
  0: t1 = a + b
  1: t2 = (int) t1
  2: return t2
func_end add@ff

func_begin add@dd
  params: a:double, b:double
  3: t1 = a + b
  4: t2 = (float) t1
  5: return t2
func_end add@dd

func_begin add@iii
  params: a:int, b:int, c:int
  6: t1 = a + b
  7: t2 = t1 + c
  8: return t2
func_end add@iii

func_begin main
  locals: i:int, f:float, t:int, g:float
  9: param 1.0
  10: param 2.5
  11: t1 = call add@ff, 2
  12: i = t1
  13: param 1.5
  14: param 2.5
  15: t2 = call add@ff, 2
  16: t3 = (float) t2
  17: f = t3
  18: param 1
  19: param 2
  20: param 3
  21: t4 = call add@iii, 3
  22: t = t4
  23: param f
  24: param 1.0
  25: t5 = call add@ff, 2
  26: t6 = (float) t5
  27: g = t6
  28: t7 = i + t
  29: return t7
func_end main
