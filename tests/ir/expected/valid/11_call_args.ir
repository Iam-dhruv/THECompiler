.data

.text
func_begin scale@if
  params: x:int, k:float
  0: t1 = (float) x
  1: t2 = t1 * k
  2: return t2
func_end scale@if

func_begin log_value@ci
  params: c:char, v:int
  3: t1 = v + c
  4: v = t1
  5: return
func_end log_value@ci

func_begin pick@v
  6: return 4
func_end pick@v

func_begin main
  locals: r:float
  7: t1 = call pick@v, 0
  8: param t1
  9: param 2.0
  10: t2 = call scale@if, 2
  11: r = t2
  12: param 'a'
  13: param 3
  14: call log_value@ci, 2
  15: t3 = (int) r
  16: return t3
func_end main
