.data
  counter: int (4) = 0  ; static
  limit: int (4) = 100  ; static
  bump@i.hidden: int (4) = 0  ; static local
  bump@i.calls: int (4) = 1  ; static local
  main.cache: int[4] (16) = 0  ; static local
  main.slot: int* (8) = &main.cache  ; static local

.text
func_begin bump@i
  params: by:int
  0: t1 = bump@i.hidden + by
  1: bump@i.hidden = t1
  2: t2 = bump@i.calls + 1
  3: bump@i.calls = t2
  4: t3 = counter + by
  5: counter = t3
  6: return bump@i.hidden
func_end bump@i

func_begin main
  7: main.cache[4] = 7
  8: *main.slot = 2
  9: param 1
  10: t1 = call bump@i, 1
  11: t2 = counter + limit
  12: return t2
func_end main
